{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aw-file-storage",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-01",
	// nodejs_compat is required by Next.js on Workers (OpenNext).
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Custom domain for the app (added originally via the dashboard). Declared
	// here so `wrangler deploy` keeps it instead of removing it. The apex
	// awvcard.com 301-redirects to www via a Cloudflare Redirect Rule (not here).
	//
	// spec 0008 cutover (public card landing + analytics): to move
	// contacts.awvcard.com onto this Worker (so /c/<slug> renders the landing
	// page and /c/<slug>.vcf is counted), the SAME hostname must first leave the
	// R2 bucket — Cloudflare will not bind it to two things. Reversible order:
	//   1. Verify /c/<slug> and /c/<slug>.vcf work on www.awvcard.com first.
	//   2. R2 dashboard → aw-files-public → remove the contacts.awvcard.com custom domain.
	//   3. Uncomment the contacts route below, then `npm run deploy`.
	//   4. Confirm a published .vcf is byte-identical and the landing renders.
	// Rollback: remove the route (re-comment + deploy) and re-add the R2 custom domain.
	"routes": [
		{ "pattern": "www.awvcard.com", "custom_domain": true }
		// , { "pattern": "contacts.awvcard.com", "custom_domain": true }  // spec 0008 cutover — see note above
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Non-secret config, available in dev and production. PUBLIC_FILE_DOMAIN is the
	// host that serves published vCards — a custom domain on the R2 public bucket
	// (aw-files-public). Objects stay at c/<slug>.vcf; only the host changed, so
	// every card URL (existing + new) resolves here without moving any objects.
	// TRUSTED_ORIGINS: extra exact origins Better Auth accepts alongside APP_URL,
	// so sign-in works on the custom domain and the workers.dev URL alike.
	"vars": {
		"TRUSTED_ORIGINS": "https://www.awvcard.com,https://awvcard.com,https://aw-file-storage.aw-file-storage.workers.dev",
		"PUBLIC_FILE_DOMAIN": "contacts.awvcard.com",
		"R2_ACCOUNT_ID": "25712314130a03e3364b9be5286c0eef",
		"R2_PRIVATE_BUCKET": "aw-files-private",
		"R2_PUBLIC_BUCKET": "aw-files-public"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aw-file-storage",
			"database_id": "8094dbad-c1e4-4220-8a52-8f071ed75ba5",
			"migrations_dir": "migrations"
		}
	],
	// R2 is accessed via the S3 API (aws4fetch) in both the browser (presigned)
	// and the Worker, so bytes always hit the same real bucket without needing
	// remote bindings (which require a workers.dev subdomain). These local
	// bindings are kept for potential future binding-based use.
	"r2_buckets": [
		{ "binding": "FILES_PRIVATE", "bucket_name": "aw-files-private" },
		{ "binding": "FILES_PUBLIC", "bucket_name": "aw-files-public" }
	],
	// ---------------------------------------------------------------------------
	// Bindings below are added as each phase needs them. Create the resources in
	// your Cloudflare account first (see the commands the assistant provides),
	// then uncomment and fill in the ids. Keep production values out of git for
	// anything sensitive; ids here are safe, secrets go through `wrangler secret`.
	// ---------------------------------------------------------------------------
	// "queues": {
	//   "producers": [{ "binding": "UPLOAD_QUEUE", "queue": "aw-upload-processing" }],
	//   "consumers": [{ "queue": "aw-upload-processing" }]
	// },
	// "triggers": { "crons": ["0 3 * * *"] }
}