{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aw-file-storage",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-01",
	// nodejs_compat is required by Next.js on Workers (OpenNext).
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Custom domain for the app (added originally via the dashboard). Declared
	// here so `wrangler deploy` keeps it instead of removing it. The apex
	// awvcard.com 301-redirects to www via a Cloudflare Redirect Rule (not here).
	//
	// spec 0008 cutover (public card landing + analytics): contacts.awvcard.com is
	// now served by this Worker (below) instead of the R2 bucket directly, so
	// /c/<slug> renders the landing page, /c/<slug>.vcf is counted, and /logos/*
	// is served by the passthrough route. The SAME hostname cannot be bound to two
	// things, so BEFORE the first deploy that carries this route you MUST remove
	// the contacts.awvcard.com custom domain from the R2 bucket (aw-files-public),
	// or the deploy is rejected. Reversible order:
	//   1. R2 dashboard → aw-files-public → remove the contacts.awvcard.com custom domain.
	//   2. `npm run deploy` (binds contacts.awvcard.com to this Worker).
	//   3. Verify: /c/<slug>.vcf byte-identical, /c/<slug> renders, /logos/<org>/<file> loads.
	// Rollback: re-comment the contacts route, `npm run deploy`, re-add the R2 custom domain.
	"routes": [
		{ "pattern": "www.awvcard.com", "custom_domain": true },
		{ "pattern": "contacts.awvcard.com", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Non-secret config, available in dev and production. PUBLIC_FILE_DOMAIN is the
	// host that serves published vCards — a custom domain on the R2 public bucket
	// (aw-files-public). Objects stay at c/<slug>.vcf; only the host changed, so
	// every card URL (existing + new) resolves here without moving any objects.
	// TRUSTED_ORIGINS: extra exact origins Better Auth accepts alongside APP_URL,
	// so sign-in works on the custom domain and the workers.dev URL alike.
	// PLATFORM_OWNER_EMAILS: comma-separated verified emails of the platform ("app")
	// owner(s) — the tier above any org role (spec 0012). Gates creating an
	// organization and changing the platform-level card-login setting. Set to the
	// real owner email(s) before deploy; matched case-insensitively.
	"vars": {
		"TRUSTED_ORIGINS": "https://www.awvcard.com,https://awvcard.com,https://aw-file-storage.aw-file-storage.workers.dev",
		"PUBLIC_FILE_DOMAIN": "contacts.awvcard.com",
		"PLATFORM_OWNER_EMAILS": "jclark@americaworks.com",
		"R2_ACCOUNT_ID": "25712314130a03e3364b9be5286c0eef",
		"R2_PRIVATE_BUCKET": "aw-files-private",
		"R2_PUBLIC_BUCKET": "aw-files-public",
		// Bulk contact-card import (spec 0028). All optional — the server falls back to
		// these same defaults if unset. MAX_IMPORT_ROWS: per-import row cap. IMPORT_RATE_
		// PER_HOUR: accepted imports per user per hour. CARD_IMPORT_DRAIN_BATCH: rows the
		// cron drain publishes per tick (kept small to stay within Worker CPU/subrequest
		// limits). CARD_IMPORT_MAX_ATTEMPTS: drain attempts before a row is marked failed.
		"MAX_IMPORT_ROWS": "250",
		"IMPORT_RATE_PER_HOUR": "5",
		"CARD_IMPORT_DRAIN_BATCH": "20",
		"CARD_IMPORT_MAX_ATTEMPTS": "3"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aw-file-storage",
			"database_id": "8094dbad-c1e4-4220-8a52-8f071ed75ba5",
			"migrations_dir": "migrations"
		}
	],
	// R2 is accessed via the S3 API (aws4fetch) in both the browser (presigned)
	// and the Worker, so bytes always hit the same real bucket without needing
	// remote bindings (which require a workers.dev subdomain). These local
	// bindings are kept for potential future binding-based use.
	"r2_buckets": [
		{ "binding": "FILES_PRIVATE", "bucket_name": "aw-files-private" },
		{ "binding": "FILES_PUBLIC", "bucket_name": "aw-files-public" }
	],
	// Cloudflare Workers AI (spec 0027): the AI binding authorizes itself (no API key). Used
	// server-side for AI-assisted help-article drafting. In local `next dev` under OpenNext the
	// platform proxy connects this to REAL Workers AI (calls count toward usage).
	"ai": { "binding": "AI" },
	// ---------------------------------------------------------------------------
	// Bindings below are added as each phase needs them. Create the resources in
	// your Cloudflare account first (see the commands the assistant provides),
	// then uncomment and fill in the ids. Keep production values out of git for
	// anything sensitive; ids here are safe, secrets go through `wrangler secret`.
	// ---------------------------------------------------------------------------
	// "queues": {
	//   "producers": [{ "binding": "UPLOAD_QUEUE", "queue": "aw-upload-processing" }],
	//   "consumers": [{ "queue": "aw-upload-processing" }]
	// },
	// "triggers": { "crons": ["0 3 * * *"] }
}