{
  "rules": [
    {
      "allowed": {
        "origins": [
        "http://localhost:3000",
        "https://aw-file-storage.aw-file-storage.workers.dev"
      ],
        "methods": ["GET", "PUT"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
